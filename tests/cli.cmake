foreach(case IN ITEMS missing unknown extra help_mixed json_missing not_found)
  if(case STREQUAL "missing")
    set(args "")
  elseif(case STREQUAL "unknown")
    set(args --unsupported)
  elseif(case STREQUAL "extra")
    set(args a b)
  elseif(case STREQUAL "help_mixed")
    set(args --help a)
  elseif(case STREQUAL "json_missing")
    set(args --json)
  else()
    set(args --json service-trigger-explainer-nonexistent-6ba67df8)
  endif()
  execute_process(COMMAND "${APP}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(case STREQUAL "not_found")
    set(expected 3)
  else()
    set(expected 2)
  endif()
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "${case}: expected ${expected}, got ${code}: ${out}${err}")
  endif()
  if(case STREQUAL "json_missing" OR case STREQUAL "not_found")
    string(JSON schema GET "${out}" schema_version)
    string(JSON exit GET "${out}" error exit_code)
    if(NOT schema EQUAL 1 OR NOT exit EQUAL expected OR NOT err STREQUAL "")
      message(FATAL_ERROR "Invalid JSON error response")
    endif()
  endif()
endforeach()
