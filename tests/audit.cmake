file(GLOB sources "${ROOT}/src/*.cpp" "${ROOT}/include/*.hpp")
foreach(source IN LISTS sources)
  file(READ "${source}" contents)
  if(contents MATCHES "(StartService|ControlService|ChangeServiceConfig|CreateService|DeleteService|RegSetValue|RegCreateKey|WSAStartup|socket|connect|send|recv|WinHttp|InternetOpen|ShellExecute|CreateProcess|system)[AW]?[ \t\r\n]*\\(")
    message(FATAL_ERROR "Forbidden mutation/network/process API in ${source}")
  endif()
  if(contents MATCHES "(^|[^A-Z_])(SERVICE_ALL_ACCESS|SC_MANAGER_ALL_ACCESS|SERVICE_START|SERVICE_STOP|SERVICE_CHANGE_CONFIG)([^A-Z_]|$)")
    message(FATAL_ERROR "Excess service access in ${source}")
  endif()
endforeach()
message(STATUS "Production source read-only and network audit passed")
